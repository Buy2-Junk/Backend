generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  Male
  Female
}

enum EmployeeStatus {
  Pending
  Active
  Suspended
}

enum JobType {
  FullTime
  PartTime
  Contract
}

enum SalaryType {
  Fixed
  Hourly
}

enum PayoutPeriod {
  Weekly
  Biweekly
  Monthly
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions Json
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]

  @@map("roles")
}

model Employee {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String?
  firstName       String
  lastName        String
  phoneNumber     String
  gender          Gender
  status          EmployeeStatus @default(Pending)
  roleId          String
  role            Role           @relation(fields: [roleId], references: [id])

  jobTitle        String?
  department      String?
  seniorityLevel  String?
  jobType         JobType?
  directManagerId String?
  directManager   Employee?      @relation("ManagementChain", fields: [directManagerId], references: [id])
  reports         Employee[]     @relation("ManagementChain")
  qualificationIds Json?

  salaryType      SalaryType?
  payoutPeriod    PayoutPeriod?
  workWeek        Json?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  otps            Otp[]

  @@index([roleId])
  @@map("employees")
}

model Otp {
  id         String     @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  usedAt     DateTime?
  createdAt  DateTime   @default(now())
  employeeId String?
  employee   Employee?  @relation(fields: [employeeId], references: [id])

  @@index([email])
  @@map("otps")
}
